  <rules>
    <rule id="squat-stubborn-rule" name="Stubborn" publicationId="squat-codex" page="15" hidden="false">
      <description>Squats are known for their stubborn nature and determination. Squat units may re-roll failed Break tests once per game.</description>
    </rule>
    <rule id="squat-tech-rule" name="Advanced Technology" publicationId="squat-codex" page="16" hidden="false">
      <description>Squats have access to advanced technology. All Squat vehicles and heavy weapons have a +1 modifier to their armor save.</description>
    </rule>
    <rule id="squat-underground-rule" name="Underground Warfare" publicationId="squat-codex" page="17" hidden="false">
      <description>Squats are masters of underground warfare. Squat infantry units may infiltrate on a roll of 4+ instead of the normal 6+.</description>
    </rule>
  </rules>
