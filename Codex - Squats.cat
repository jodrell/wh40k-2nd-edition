<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="squat-1234-5678-9abc" name="Codex - Squats" revision="1" battleScribeVersion="2.03" authorName="Boff" library="false" gameSystemId="9ea8-c89d-9104-ed03" gameSystemRevision="23" xmlns="http://www.battlescribe.net/schema/catalogueSchema" type="catalogue">
  <readme>Squats are a hardy, technologically advanced race of abhumans who inhabit the galactic core. They are known for their exceptional craftsmanship, advanced technology, and stubborn determination. This catalogue includes the basic Squat units and characters available in Warhammer 40k 2nd Edition.</readme>
  <categoryEntries>
    <categoryEntry id="squat-char-001" name="Characters" hidden="false"/>
    <categoryEntry id="squat-squad-002" name="Squads" hidden="false"/>
    <categoryEntry id="squat-support-003" name="Support" hidden="false"/>
  </categoryEntries>
  <forceEntries>
